<?xml version="1.0" encoding="utf-8"?>
<!--
  小满账本 Android 外壳
  根据 v1.2.0 安装包逆向重建，行为与原包一致；字段值均来自原 AndroidManifest.xml。

  注意：原包的 allowBackup 为 true，这里保持一致。
  如果你在意「物理接触设备者可用 adb backup 导出账本」，改成 false。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaoman.ledger">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!--
      唯一申请的权限。看似矛盾：应用完全离线，为何要网络权限？
      因为本地 AssetServer 监听 127.0.0.1:4178，Socket 绑定同样受 INTERNET 权限管辖。
      没有任何外网请求。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:appCategory="7"
        android:enableOnBackInvokedCallback="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <!--
          usesCleartextTraffic=true 仅为允许 WebView 访问 http://127.0.0.1:4178。
          此流量不出本机回环口。若要收紧，见 res/xml/network_security_config.xml 的注释。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="true" 是 NotificationListenerService 的标准写法：系统需要能绑定它。
          permission 属性保证只有持有 BIND_NOTIFICATION_LISTENER_SERVICE 签名的
          系统组件可以绑定，第三方 App 无法直接调用。
        -->
        <service
            android:name=".AutoRecordService"
            android:exported="true"
            android:label="@string/auto_record_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
